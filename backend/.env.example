# Copy this file to .env and set your own student_app password.
DB_NAME=student_management
DB_USER=student_app
DB_PASSWORD='REPLACE_WITH_YOUR_APPLICATION_PASSWORD'
DB_HOST=localhost
DB_PORT=3306
